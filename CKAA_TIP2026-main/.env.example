# =============================================================================
# CKAA + AQCL — environment configuration template
#
# Copy this file to `.env` (git-ignored) and adjust the values. The startup
# scripts in `scripts/` read these variables when present, and fall back to the
# defaults documented below when they are unset.
# =============================================================================

# Directory that contains the raw CSV streams data_1_S1/ and data_2_S1/.
#   - Used by scripts/prepare_data.{sh,ps1} via tools/prepare_tabular_dataset.py
#   - Default (unset): the parent directory of this repository ("..")
# DATA_RAW_ROOT=/absolute/path/to/raw/data

# Which GPU to use (PyTorch device ids). Default: 0.
# CUDA_VISIBLE_DEVICES=0

# DataLoader workers. Default: 0 (most portable; avoids subprocess issues).
# NUM_WORKERS=0

# CKAA run overrides (scripts/run_ckaa.*)
# SEED=2024
# EPOCHS=12
# CKAA_SUFFIX=ckaa_paper1_s2024

# AQCL matrix overrides (scripts/run_aqcl_matrix.*)
# AQCL_CASES=fp32,fixed8,fixed4,fixed2
# AQCL_SEEDS=2024,2025
# AQCL_EPOCHS=8
# AQCL_PREFIX=tc
